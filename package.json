{
  "name": "ng-openapi-signals",
  "version": "0.10.2",
  "description": "Signal-first OpenAPI client generator for Angular using resource() and fetch().",
  "type": "module",
  "bin": {
    "ng-openapi-signals": "dist/cli.mjs"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:example": "npm run build && node dist/cli.mjs generate --config examples/ng-openapi-signals.config.ts",
    "check:example": "npm run build && node dist/cli.mjs generate --config examples/ng-openapi-signals.config.ts --check",
    "check:publint": "publint",
    "check:attw": "attw --pack",
    "check:knip": "knip",
    "check:release": "npm run check:publint && npm run check:attw && npm run check:knip"
  },
  "keywords": [
    "angular",
    "angular-22",
    "openapi",
    "swagger",
    "signals",
    "resource",
    "fetch",
    "codegen",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realdeepnull/ng-openapi-signals.git"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "knip": "^6.44.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
